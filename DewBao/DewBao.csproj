<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DewBao</AssemblyName>
    <RootNamespace>DewBao</RootNamespace>
    <AssemblyTitle>DewBao</AssemblyTitle>
    <Product>DewBao</Product>
    <Copyright>2026</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DPI 感知（.NET 8 推荐方式，替代 manifest 中的 dpiAware 节） -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- UAC 清单：以管理员权限运行，解决全屏游戏热键无效问题 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

</Project>